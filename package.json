{
  "name": "vivaldi-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "node -e \"const fs=require('fs'),f='public/manifest.json',m=JSON.parse(fs.readFileSync(f));m.version=process.env.npm_package_version;fs.writeFileSync(f,JSON.stringify(m,null,2)+'\\n')\" && git add public/manifest.json"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
